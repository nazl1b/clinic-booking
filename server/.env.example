# Copy this file to .env and fill in the values. Never commit .env.

# Port of the Express server (default 3000)
PORT=

# Neon: pooled connection string (contains -pooler), used by the app
DATABASE_URL=
# Neon: direct connection string (no -pooler), used by Prisma migrations
DIRECT_URL=

# Long random string used to sign session cookies
SESSION_SECRET=

# Time zone of the clinic (Europe/Athens)
CLINIC_TIMEZONE=

# Public URL of the app, used in email links
APP_URL=

# Email service: ethereal (development, fake inbox) or brevo (production). Empty = ethereal
EMAIL_PROVIDER=

# Ethereal inbox from ethereal.email (optional; empty = a new temporary inbox on every start)
ETHEREAL_USER=
ETHEREAL_PASS=

# Brevo API key (production only) and verified sender address
BREVO_API_KEY=
EMAIL_FROM=

# Secret key for /api/cron/reminders
CRON_SECRET=

# Header with the visitor's IP, for the rate limits. On Render: cf-connecting-ip
# (Cloudflare sets it). Leave empty locally.
CLIENT_IP_HEADER=

# First admin account, created by the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password of the seeded demo doctors and patients. Leave empty to seed only the admin.
SEED_DEMO_PASSWORD=
